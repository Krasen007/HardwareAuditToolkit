<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: contracts, orchestrator and session models.
    No UI and no Win32/P-Invoke references by design (architecture §3, §5) —
    this project stays dependency-free so the orchestrator and models remain
    trivially unit-testable.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HardwareAuditToolkit.Core</RootNamespace>
  </PropertyGroup>

</Project>
