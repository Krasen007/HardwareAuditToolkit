<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: contracts, orchestrator, session models, event-bus payloads, keyboard
    layout, and the Application-layer test modules (ITestModule implementations).
    No UI and no directly-authored Win32/P-Invoke code (architecture §3, §5):
    the modules depend on Infrastructure purely through its interfaces, and the
    in-process event bus is CommunityToolkit's WeakReferenceMessenger (UI-agnostic).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>HardwareAuditToolkit.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\HardwareAuditToolkit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
