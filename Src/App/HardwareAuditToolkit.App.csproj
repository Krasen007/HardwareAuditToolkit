<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App: WPF host / shell. Wires up DI, the single-instance enforcer (§9.3),
    and the per-monitor V2 DPI manifest (§9.4). Publish profiles live in
    Properties\PublishProfiles (primary single-file + folder fallback, §9.1).
  -->

  <PropertyGroup>
        <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>HardwareAuditToolkit</AssemblyName>
    <RootNamespace>HardwareAuditToolkit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>

    <Version>0.1.0</Version>
    <Product>Hardware Audit Toolkit</Product>
    <Description>Portable sysadmin hardware audit toolkit — keyboard, mouse, monitor, system info, and CPU stress testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\HardwareAuditToolkit.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\HardwareAuditToolkit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <!--
    Single-file publishing should end with precisely one artifact. Referenced
    projects still emit portable PDBs into the publish folder; drop them so the
    "single self-contained .exe" story holds (§9.1/Confirmed decision 1).
  -->
  <Target Name="RemovePdbFromPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_UnwantedPublishPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_UnwantedPublishPdb)" TreatErrorsAsWarnings="true" />
  </Target>

  <!--
    English-only deployment: the WPF framework reference pulls satellite
    localization folders (cs/de/es/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant)
    into the folder publish, holding non-English UI/print-dialog .resources.dll
    (~15 MB). The app ships English only, so this strips them from the folder
    profile. The single-file profile bundles these into the .exe already, so the
    target is gated to non-single-file publishes (and is a no-op there regardless).
  -->
  <Target Name="RemoveWpfLocalisationFolders" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_WpfLocalisationCultures Include="cs;de;es;fr;it;ja;ko;pl;pt-BR;ru;tr;zh-Hans;zh-Hant" />
      <_WpfLocalisationFolder Include="@(_WpfLocalisationCultures -> '$(PublishDir)%(identity)')" />
    </ItemGroup>
    <Message Importance="high" Text="RemoveWpfLocalisationFolders: singlefile='$(PublishSingleFile)', pubdir='$(PublishDir)', folders=@(_WpfLocalisationFolder)" />
    <RemoveDir Directories="@(_WpfLocalisationFolder)" />
  </Target>

  <!--
    Phase 7 / §9.1 — "exactly one artifact" DoD, asserted documentably. Opt-in
    (pass -p:VerifyPublishArtifacts=true) so it never slows the normal build/test
    or an unguarded publish. Counts .exe files in the publish output; a single-file
    build must produce exactly one, or the profile is misconfigured.
  -->
  <Target Name="VerifySingleFileArtifact" AfterTargets="Publish" Condition="'$(VerifyPublishArtifacts)' == 'true'">
    <ItemGroup>
      <_PublishedExe Include="$(PublishDir)**\*.exe" />
    </ItemGroup>
    <Error Condition="@(_PublishedExe->Count()) != 1"
           Text="Single-file publish must produce exactly one .exe; found @(_PublishedExe->Count()). Re-check the PortableSingleFile profile (§9.1)." />
  </Target>

</Project>
