<Window x:Class="HardwareAuditToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
        xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
        xmlns:conv="clr-namespace:HardwareAuditToolkit.App.Converters"
        mc:Ignorable="d"
        Title="Hardware Audit Toolkit"
        Icon="pack://application:,,,/Assets/appicon.ico"
        Height="760" MinHeight="720" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ViewModel-first navigation: the content region renders the current screen. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardHomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoModuleViewModel}">
            <views:SystemInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuStressModuleViewModel}">
            <views:CpuStressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardTestModuleViewModel}">
            <views:KeyboardTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MouseTestModuleViewModel}">
            <views:MouseTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorTestModuleViewModel}">
            <views:MonitorTestView />
        </DataTemplate>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Persistent header (roadmap E2): the single copy of Back / Export / Exit,
             replacing the per-view exit overlays and dashboard buttons. Exit Test is
             the mouse twin of Ctrl+E — the one deliberate abort; navigating away or
             closing the window records nothing (roadmap Phase 2). -->
        <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="16,10"
                BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Hardware Audit Toolkit"
                           FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back to dashboard"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding IsDashboard, Converter={StaticResource InverseBoolToVis}}"
                            Padding="14,6" FontSize="14" Margin="0,0,12,0" Cursor="Hand" />
                    <Button Content="Export Report"
                            Command="{Binding ExportReportCommand}"
                            Padding="14,6" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"
                            Foreground="White" Background="#2E7D32" BorderBrush="#1B5E20"
                            BorderThickness="1" Cursor="Hand" />
                    <Button Content="Exit Test (Ctrl+E)"
                            Command="{Binding ExitTestCommand}"
                            Padding="14,6" FontSize="14" FontWeight="SemiBold"
                            Foreground="White" Background="#C0392B" BorderBrush="#922B21"
                            BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentScreen}" />
    </DockPanel>
</Window>
