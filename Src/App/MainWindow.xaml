<Window x:Class="HardwareAuditToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
        xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
        mc:Ignorable="d"
        Title="Hardware Audit Toolkit"
        Height="640" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ViewModel-first navigation: the content region renders the current screen. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardHomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModulePlaceholderViewModel}">
            <views:ModulePlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoModuleViewModel}">
            <views:SystemInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuStressModuleViewModel}">
            <views:CpuStressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardTestModuleViewModel}">
            <views:KeyboardTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MouseTestModuleViewModel}">
            <views:MouseTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorTestModuleViewModel}">
            <views:MonitorTestView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentScreen}" />
    </Grid>
</Window>
