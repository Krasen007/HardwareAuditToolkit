<UserControl x:Class="HardwareAuditToolkit.App.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModulePlaceholderViewModel}"
             d:DesignHeight="540" d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <!-- Reusable exit overlay, pinned top-right (§6). -->
        <views:ExitOverlay HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock Text="{Binding DisplayName}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#BBBBBB" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
            <Border Margin="0,16,0,0" Padding="10,6" HorizontalAlignment="Center" CornerRadius="4"
                    Background="#3F3F46" Visibility="{Binding IsExclusive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Exclusive module — runs alone" FontSize="11" Foreground="#CCCCCC" />
            </Border>
            <TextBlock Text="This module is implemented in a later phase. The exit paths (Ctrl+E, the Exit Test button, and the window close) are fully wired and work from this screen."
                       FontSize="12" Foreground="#888888" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Margin="0,18,0,0" />
            <Button Content="Back to dashboard" Command="{Binding BackCommand}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Padding="16,8" FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
