<Window x:Class="HardwareAuditToolkit.App.Views.ExportResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:HardwareAuditToolkit.App.Converters"
        mc:Ignorable="d"
        Title="Audit Report Exported"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Audit report exported" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8E8" />
        <TextBlock Margin="0,12,0,0" Text="Saved to:" FontWeight="SemiBold" Foreground="#CCCCCC" />
        <TextBox Text="{Binding ReportPath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                 TextWrapping="Wrap" Background="#1E1E1E" Foreground="#E8E8E8" BorderBrush="#3F3F46" />
        <TextBlock Margin="0,8,0,0" Text="JSON data:" FontWeight="SemiBold" Foreground="#CCCCCC" />
        <TextBox Text="{Binding JsonPath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0"
                 TextWrapping="Wrap" Background="#1E1E1E" Foreground="#E8E8E8" BorderBrush="#3F3F46" />
        <TextBlock Margin="0,4,0,0" Text="{Binding StatusMessage}"
                   Foreground="#E8A33D" TextWrapping="Wrap"
                   Visibility="{Binding ShowStatusMessage, Converter={StaticResource InvBoolToVis}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open Report" Click="OpenReport_Click"
                    Padding="14,6" FontWeight="SemiBold" Foreground="White"
                    Background="#2E7D32" BorderBrush="#1B5E20" BorderThickness="1"
                    Cursor="Hand" IsEnabled="{Binding HasFile}" />
            <Button Content="Open Folder" Click="OpenFolder_Click"
                    Padding="14,6" FontWeight="SemiBold" Foreground="White"
                    Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                    Cursor="Hand" Margin="8,0,0,0" IsEnabled="{Binding HasFile}" />
            <Button Content="Close" Click="Close_Click" IsCancel="True"
                    Padding="14,6" FontWeight="SemiBold" Margin="8,0,0,0"
                    Cursor="Hand" />
        </StackPanel>
    </StackPanel>
</Window>
