<UserControl x:Class="HardwareAuditToolkit.App.Views.MouseTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
             xmlns:conv="clr-namespace:HardwareAuditToolkit.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MouseTestModuleViewModel}"
             d:DesignHeight="540" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <!-- Reusable mouse-only exit path, pinned top-right (§6). -->
        <views:ExitOverlay HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mouse Test" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock FontSize="12" Foreground="#9AE6B0" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="L:" /><Run Text="{Binding LeftClicks}" FontWeight="SemiBold" />
                    <Run Text="  R:" /><Run Text="{Binding RightClicks}" FontWeight="SemiBold" />
                    <Run Text="  M:" /><Run Text="{Binding MiddleClicks}" FontWeight="SemiBold" />
                    <Run Text="  Wheel:" /><Run Text="{Binding WheelTicks}" FontWeight="SemiBold" />
                    <Run Text="  Drags:" /><Run Text="{Binding DragCount}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Content="Tracing test" Command="{Binding ToggleTraceCommand}"
                        Padding="12,6" FontSize="12" Margin="16,0,0,0" />
            </StackPanel>

            <!-- Event log (click/scroll/drag) -->
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                    Background="#252526" BorderBrush="#3F3F46" BorderThickness="1"
                    Visibility="{Binding IsTraceMode, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Click / scroll / drag log"
                               FontSize="13" FontWeight="SemiBold" Foreground="#E8E8E8" Margin="0,0,0,8" />
                    <!-- Read-only log: ItemsControl has no selection, no focus,
                         no scrollbars, and cannot be hit-tested — the newest
                         entry stays pinned at the top. Wheel detection is raw
                         input, unaffected by this UI. -->
                    <ItemsControl ItemsSource="{Binding LogLines}"
                                  Background="Transparent"
                                  Foreground="#D8D8D8" FontSize="12"
                                  IsHitTestVisible="False"
                                  Focusable="False"
                                  ClipToBounds="True" />
                </DockPanel>
            </Border>

            <!-- Tracing sub-screen -->
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                    Background="#252526" BorderBrush="#3F3F46" BorderThickness="1"
                    Visibility="{Binding IsTraceMode, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8E8" Margin="0,0,0,8">
                        <Run Text="Tracing test — hold a button and trace the " /><Run Text="{Binding TraceTargetName}" /><Run Text=" outline." />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TraceResultText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#9AE6B0" Margin="0,0,0,8" />
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center">
                        <Canvas x:Name="TraceCanvas"
                                 Width="{x:Static vm:MouseTestModuleViewModel.TraceCanvasWidth}" Height="{x:Static vm:MouseTestModuleViewModel.TraceCanvasHeight}"
                                Background="#1B1B1C"
                                MouseDown="TraceCanvas_MouseDown"
                                MouseMove="TraceCanvas_MouseMove"
                                MouseUp="TraceCanvas_MouseUp"
                                MouseLeave="TraceCanvas_MouseUp">
                            <Polyline Points="{Binding TraceTargetPoints}"
                                      Stroke="#555555" StrokeThickness="3" StrokeDashArray="4 4"
                                      Fill="Transparent" />
                            <Polyline Points="{Binding TracePoints}"
                                      Stroke="#FFD479" StrokeThickness="3"
                                      Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding DeviceWarning}" FontSize="12" Foreground="#E67E22"
                           Margin="0,0,0,8" Visibility="{Binding IsDeviceWarning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#9AAA9A" Margin="0,0,0,10"
                           Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVis}}" />
                <TextBlock Text="{Binding FinalStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#FFD479"
                           Margin="0,0,0,10" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />

                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                    <TextBlock Text="What's wrong? (optional, recorded if you flag a defect)"
                               FontSize="12" Foreground="#9AAA9A" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding DefectNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="420" MaxWidth="640" Padding="8,5" FontSize="13" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Start test" Command="{Binding StartTestCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold"
                            Background="#27632A" Foreground="White" BorderBrush="#1E4D20" BorderThickness="1" />
                    <Button Content="Confirm all works" Command="{Binding ConfirmCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                            Background="#2D6CA3" Foreground="White" BorderBrush="#1E4D70" BorderThickness="1" />
                    <Button Content="Flag defective" Command="{Binding FlagDefectCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                            Background="#C0392B" Foreground="White" BorderBrush="#922B21" BorderThickness="1" />
                    <Button Content="Reset" Command="{Binding ResetCommand}"
                            Padding="16,9" FontSize="14" Margin="12,0,0,0" />
                    <Button Content="Back to dashboard" Command="{Binding BackCommand}"
                            Padding="16,9" FontSize="14" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
