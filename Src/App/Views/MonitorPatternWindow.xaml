<Window x:Class="HardwareAuditToolkit.App.Views.MonitorPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
        mc:Ignorable="d"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Black" Title="Monitor Pattern"
        d:DesignHeight="1080" d:DesignWidth="1920">
    <Grid>
        <!-- Full-bleed pattern surface (renders at the monitor's own DPI via the
             Per-Monitor V2 manifest, §9.4). -->
        <Border x:Name="PatternBorder" />

        <!-- Auto-hiding controls: a mouse-only "Back to controls" path and the
             reusable Exit overlay (§6). Hidden after a few seconds of no mouse
             movement; reappear on any mouse move. -->
        <StackPanel x:Name="OverlayPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <Button x:Name="BackButton" Content="Back to controls"
                    Padding="14,8" FontSize="14" FontWeight="SemiBold"
                    Foreground="White" Background="#2D2D30"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand" Click="BackButton_Click" />
            <views:ExitOverlay Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
