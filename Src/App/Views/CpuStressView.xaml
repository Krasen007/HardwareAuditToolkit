<UserControl x:Class="HardwareAuditToolkit.App.Views.CpuStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CpuStressModuleViewModel}"
             d:DesignHeight="540" d:DesignWidth="860">
    <Grid Background="#1E1E1E">
        <!-- Reusable mouse-only exit path, pinned top-right (§6). -->
        <views:ExitOverlay HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="CPU Stress Test" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#9AAA9A" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,0" Padding="18" CornerRadius="8"
                            Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#BBBBBB" HorizontalAlignment="Center">
                        <Run Text="Cores loaded:" />
                        <Run Text="{Binding CoreCount}" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </TextBlock>

                    <TextBlock FontSize="40" FontWeight="Bold" Foreground="#FFD479"
                               HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Run Text="{Binding ElapsedText}" />
                        <Run Text=" / " Foreground="#666666" />
                        <Run Text="{Binding TargetText}" Foreground="#888888" />
                    </TextBlock>

                    <ProgressBar Height="14" Margin="40,12,40,0" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" Foreground="#E67E22" />

                    <Grid Margin="40,18,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="CPU LOAD" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CpuLoadText}" FontSize="16" Foreground="#E8E8E8"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="TEMPERATURES" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TempsText}" FontSize="13" Foreground="#E8E8E8"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="All cores run at BelowNormal priority so the UI and Ctrl+E stay responsive (§8, §9.2)."
                               FontSize="11" Foreground="#777777" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="40,18,40,0" />
                </StackPanel>
            </Border>

                    <!-- Live temperature & CPU-load graph -->
                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="8"
                            Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Live graph — CPU load &amp; core temperature" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8E8" />
                            <TextBlock Text="Sampled continuously — before you press Start (current load) and throughout the burn-in. Gold = CPU load %, blue = maximum core temperature °C."
                                       FontSize="11" Foreground="#BBBBBB" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Canvas Width="{x:Static vm:CpuStressModuleViewModel.GraphWidth}"
                                        Height="{x:Static vm:CpuStressModuleViewModel.GraphHeight}" Background="#1B1B1C">
                                    <Polyline Points="{Binding LoadPoints}" Stroke="#FFD479" StrokeThickness="2" Fill="Transparent" />
                                    <Polyline Points="{Binding TempPoints}" Stroke="#5AA9E6" StrokeThickness="2" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="CPU load axis is fixed 0–100 %; the temperature axis auto-scales to the reported range."
                                       FontSize="11" Foreground="#888888" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Start test" Command="{Binding StartTestCommand}"
                        Padding="18,9" FontSize="14" FontWeight="SemiBold"
                        Background="#27632A" Foreground="White" BorderBrush="#1E4D20" BorderThickness="1" />
                <Button Content="Stop test" Command="{Binding StopTestCommand}"
                        Padding="18,9" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                        Background="#C0392B" Foreground="White" BorderBrush="#922B21" BorderThickness="1" />
                <Button Content="Back to dashboard" Command="{Binding BackCommand}"
                        Padding="16,9" FontSize="14" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
