<UserControl x:Class="HardwareAuditToolkit.App.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="540" d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a test module"
                   FontSize="20" FontWeight="SemiBold" Foreground="#E8E8E8" Margin="4,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DashboardItemViewModel}">
                        <Border Width="240" Height="120" Margin="6" Padding="14"
                                CornerRadius="8" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding OpenCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                            Background="#3F3F46" Visibility="{Binding IsExclusive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="exclusive" FontSize="10" Foreground="#CCCCCC" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#BBBBBB"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#888888"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E8E8E8">
                    <Run Text="Connected devices — Keyboards:" />
                    <Run Text="{Binding DataContext.DeviceChange.KeyboardCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                    <Run Text="  Mice:" />
                    <Run Text="{Binding DataContext.DeviceChange.MouseCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                    <Run Text="  Monitors:" />
                    <Run Text="{Binding DataContext.DeviceChange.MonitorCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding DataContext.DeviceChange.LastEvent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                           FontSize="11" Foreground="#999999" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
