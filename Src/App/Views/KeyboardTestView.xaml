<UserControl x:Class="HardwareAuditToolkit.App.Views.KeyboardTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
             xmlns:conv="clr-namespace:HardwareAuditToolkit.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:KeyboardTestModuleViewModel}"
             d:DesignHeight="540" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:KeyStateToBrushConverter x:Key="KeyStateBrush" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <!-- Reusable mouse-only exit path, pinned top-right (§6). -->
        <views:ExitOverlay HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Keyboard Test" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="#9AE6B0"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="Typing test (WPM)" Command="{Binding ToggleWpmCommand}"
                        Padding="12,6" FontSize="12" Margin="16,0,0,0" />
            </StackPanel>

            <!-- Key coverage grid + fixed latest-press log. The grid scrolls
                 independently; the log is a pinned, non-scrolling bar at the bottom
                 (mirrors the mouse test's pinned click/scroll/drag log — newest at
                 top, no scrollbar). -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsWpmMode, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:KeyViewModel}">
                            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="4"
                                    BorderBrush="#444444" BorderThickness="1"
                                    Background="{Binding State, Converter={StaticResource KeyStateBrush}}">
                                <Grid>
                                    <TextBlock Text="{Binding Label}" Foreground="#E8E8E8" FontSize="10"
                                               TextWrapping="Wrap" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <!-- Repeat badge: visible once a key has been pressed more than once,
                                         so a repeated press is clearly distinct from a single green fill. -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="3,0,3,0" Padding="4,0" CornerRadius="5"
                                            Background="#C0392B"
                                            Visibility="{Binding ShowCountBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PressCount}" Foreground="White" FontSize="9"
                                                   FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- WPM sub-screen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsWpmMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel MaxWidth="640">
                    <TextBlock Text="Typing speed &amp; accuracy" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="Type the sentence below, then Score. Gross WPM and accuracy are recorded to the session."
                               FontSize="12" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="{Binding WpmTarget}" FontSize="14" Foreground="#FFD479" TextWrapping="Wrap" />
                    </Border>
                    <TextBox Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWpmRunning}"
                             MinHeight="70" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="14" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Start typing" Command="{Binding StartWpmCommand}"
                                Padding="16,8" FontSize="14" FontWeight="SemiBold"
                                Background="#27632A" Foreground="White" BorderBrush="#1E4D20" BorderThickness="1" />
                        <Button Content="Score" Command="{Binding ScoreWpmCommand}"
                                Padding="16,8" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                                Background="#2D6CA3" Foreground="White" BorderBrush="#1E4D70" BorderThickness="1" />
                        <Button Content="Back to key grid" Command="{Binding ToggleWpmCommand}"
                                Padding="14,8" FontSize="13" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding WpmResultText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="#9AE6B0" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
                </StackPanel>

                <!-- Pinned, non-scrolling newest-first key-press log (mirrors the mouse test's log). -->
                <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" CornerRadius="8" MaxHeight="110"
                        Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Latest key presses"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding LogLines}"
                                      Background="Transparent" Foreground="#D8D8D8" FontSize="11"
                                      IsHitTestVisible="False" Focusable="False"
                                      ClipToBounds="True" />
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#9AAA9A" Margin="0,0,0,10"
                           Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVis}}" />
                <TextBlock Text="{Binding FinalStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#FFD479"
                           Margin="0,0,0,10" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />

                <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                    <TextBlock Text="What's wrong? (optional, recorded if you flag a defect)"
                               FontSize="12" Foreground="#9AAA9A" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding DefectNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="420" MaxWidth="640" Padding="8,5" FontSize="13" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Start test" Command="{Binding StartTestCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold"
                            Background="#27632A" Foreground="White" BorderBrush="#1E4D20" BorderThickness="1" />
                    <Button Content="Confirm all keys work" Command="{Binding ConfirmCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                            Background="#2D6CA3" Foreground="White" BorderBrush="#1E4D70" BorderThickness="1" />
                    <Button Content="Flag defective key" Command="{Binding FlagDefectCommand}"
                            Padding="18,9" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                            Background="#C0392B" Foreground="White" BorderBrush="#922B21" BorderThickness="1" />
                    <Button Content="Reset" Command="{Binding ResetKeysCommand}"
                            Padding="16,9" FontSize="14" Margin="12,0,0,0" />
                    <Button Content="Back to dashboard" Command="{Binding BackCommand}"
                            Padding="16,9" FontSize="14" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
