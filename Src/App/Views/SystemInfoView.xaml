<UserControl x:Class="HardwareAuditToolkit.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:HardwareAuditToolkit.App.ViewModels"
             xmlns:views="clr-namespace:HardwareAuditToolkit.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemInfoModuleViewModel}"
             d:DesignHeight="540" d:DesignWidth="860">
    <Grid Background="#1E1E1E">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="System Info" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#9AAA9A" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8"
                        Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Inventory (WMI/CIM)" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#E8E8E8" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Inventory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                       Foreground="#888888" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                       Foreground="#DDDDDD" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8"
                        Background="#252526" BorderBrush="#3F3F46" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E8E8E8" Margin="0,0,0,8">
                            <Run Text="Live sensors (" />
                            <Run Text="{Binding SensorCount}" />
                            <Run Text=")" />
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sensors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SensorRow}">
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock FontSize="11" Foreground="#777777"
                                                       Text="{Binding Hardware}" />
                                            <TextBlock FontSize="12" Foreground="#DDDDDD"
                                                       Text="{Binding Display}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
